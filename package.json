{
  "name": "hermsec",
  "version": "0.1.1",
  "description": "Local-first security assistant for vibe-coded repositories.",
  "type": "module",
  "private": false,
  "license": "UNLICENSED",
  "bin": {
    "hermsec": "./dist/src/bin/hermsec.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "docs/npm-install.md",
    "docs/pmg-setup.md"
  ],
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run build:core",
    "build:core": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/tests/**/*.test.js\"",
    "dev": "npm run build && node dist/src/bin/hermsec.js",
    "desktop:install": "npm --prefix desktop ci",
    "desktop:dev": "npm --prefix desktop run dev",
    "desktop:typecheck": "npm --prefix desktop run typecheck",
    "desktop:build": "npm --prefix desktop run build",
    "desktop:smoke:doctor": "npm --prefix desktop run smoke:doctor",
    "desktop:smoke:dashboard": "npm --prefix desktop run smoke:dashboard",
    "desktop:dist:win": "npm --prefix desktop run dist:win",
    "desktop:dist:mac": "npm --prefix desktop run dist:mac",
    "eval:owasp": "npm run build:core && node scripts/eval-owasp-benchmark.mjs --skip-if-missing",
    "start": "node dist/src/bin/hermsec.js",
    "prepack": "npm run build",
    "pack:dry-run": "npm pack --dry-run --ignore-scripts"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@types/node": "22.12.0",
    "typescript": "5.7.2"
  }
}
