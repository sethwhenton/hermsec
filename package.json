{
  "name": "hermsec",
  "version": "0.1.0",
  "description": "Local-first security assistant for vibe-coded repositories.",
  "type": "module",
  "private": false,
  "license": "UNLICENSED",
  "bin": {
    "hermsec": "./dist/src/bin/hermsec.js"
  },
  "files": [
    "dist/src",
    "dist/renderer",
    "README.md",
    "docs/npm-install.md",
    "docs/pmg-setup.md"
  ],
  "scripts": {
    "build": "npm run build:core && npm run build:renderer",
    "build:core": "tsc -p tsconfig.json",
    "build:renderer": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/tests/**/*.test.js\"",
    "dev": "npm run build && node dist/src/bin/hermsec.js",
    "dev:desktop": "npm run build && electron dist/src/desktop/main.js",
    "start:desktop": "electron dist/src/desktop/main.js",
    "test:desktop": "npm run build && electron dist/src/desktop/main.js --smoke",
    "start": "node dist/src/bin/hermsec.js",
    "prepack": "npm run build",
    "pack:dry-run": "npm pack --dry-run --ignore-scripts"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@types/blessed": "0.1.27",
    "@types/node": "22.12.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@vitejs/plugin-react": "6.0.0",
    "electron": "40.10.2",
    "typescript": "5.7.2",
    "vite": "8.0.14"
  },
  "dependencies": {
    "blessed": "0.1.81",
    "lucide-react": "0.475.0",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  }
}
