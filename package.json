{
  "name": "hermsec",
  "version": "0.1.0",
  "description": "Local-first security assistant for vibe-coded repositories.",
  "type": "module",
  "private": false,
  "license": "UNLICENSED",
  "bin": {
    "hermsec": "./dist/src/bin/hermsec.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "docs/npm-install.md",
    "docs/pmg-setup.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/tests/**/*.test.js\"",
    "dev": "npm run build && node dist/src/bin/hermsec.js",
    "start": "node dist/src/bin/hermsec.js",
    "prepack": "npm run build",
    "pack:dry-run": "npm pack --dry-run --ignore-scripts"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.7.2"
  }
}
