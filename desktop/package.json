{
  "name": "hermsec-v3",
  "version": "0.1.6",
  "description": "Hermsec desktop security scanning workspace",
  "author": "Hermsec",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "npm run prepare:cli-bundle && npm run dev:renderer",
    "dev:renderer": "node scripts/copy-report-templates.mjs && electron-vite dev",
    "dev:clean": "node scripts/dev-clean.mjs",
    "build": "electron-vite build && node scripts/copy-report-templates.mjs",
    "prepare:cli-bundle": "node scripts/prepare-cli-bundle.mjs",
    "prepare:runtime-tools": "node scripts/prepare-runtime-tools.mjs",
    "build:packaged": "npm run prepare:cli-bundle && npm run prepare:runtime-tools && npm run build",
    "preview": "electron-vite preview",
    "smoke:doctor": "node scripts/smoke-doctor.mjs",
    "smoke:dashboard": "node scripts/smoke-dashboard.mjs",
    "smoke:ui": "node scripts/smoke-ui.mjs",
    "smoke:scan-modes": "node scripts/smoke-scan-modes.mjs",
    "dist:win": "npm run build:packaged && npx electron-builder --win nsis portable --x64 --publish never",
    "dist:mac": "npm run build:packaged && npx electron-builder --mac dmg zip --publish never",
    "dist:mac:x64": "npm run build:packaged && npx electron-builder --mac dmg zip --x64 --publish never",
    "dist:mac:arm64": "npm run build:packaged && npx electron-builder --mac dmg zip --arm64 --publish never",
    "dist:linux": "npm run build:packaged && npx electron-builder --linux AppImage --x64 --publish never",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "setup:electron": "node node_modules/electron/install.js"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.542.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^42.3.3",
    "electron-vite": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "7.3.5"
  },
  "build": {
    "appId": "com.hermsec.desktop",
    "productName": "Hermsec",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "."
      }
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "icon": "resources/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "icon": "resources/icon.png",
      "target": [
        "AppImage"
      ]
    }
  }
}
