{
  "name": "hermsec-v3",
  "version": "0.1.0",
  "description": "Hermsec desktop security scanning workspace",
  "author": "Hermsec",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/copy-report-templates.mjs && electron-vite dev",
    "dev:clean": "node scripts/dev-clean.mjs",
    "build": "electron-vite build && node scripts/copy-report-templates.mjs",
    "preview": "electron-vite preview",
    "smoke:dashboard": "node scripts/smoke-dashboard.mjs",
    "dist:win": "bun run build && npx electron-builder --win nsis portable --x64 --publish never",
    "dist:mac": "bun run build && npx electron-builder --mac dmg zip --publish never",
    "dist:linux": "bun run build && npx electron-builder --linux AppImage --x64 --publish never",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "postinstall": "node node_modules/electron/install.js",
    "setup:electron": "node node_modules/electron/install.js"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.542.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^42.3.3",
    "electron-vite": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^8.0.0"
  },
  "build": {
    "appId": "com.hermsec.desktop",
    "productName": "Hermsec",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "."
      }
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "icon": "resources/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "icon": "resources/icon.png",
      "target": [
        "AppImage"
      ]
    }
  }
}
